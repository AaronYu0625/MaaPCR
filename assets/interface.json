        "商店購買項": {
            "type": "select",
            "cases": [
                {
                    "name": "只買藥水",
                    "pipeline_override": {
                        "一般購買": {
                            "recognition": {
                                "type": "OCR",
                                "param": {
                                    "expected": [
                                        "藥水"
                                    ]
                                }
                            },
                            "action": {
                                "type": "Click",
                                "param": {
                                    "target": [
                                        449,
                                        169,
                                        1,
                                        1
                                    ]
                                }
                            }
                        },
                        "重置確認": {
                            "next": [
                                "全部選擇"
                            ]
                        }
                    }
                },
                {
                    "name": "只買精煉石",
